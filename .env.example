# Blockfrost Cardano API Configuration
# Get your project key at https://blockfrost.io (Cardano Mainnet project)

# Blockfrost Project ID / API Key (starts with 'mainnet...')
BLOCKFROST_API_KEY=your_blockfrost_project_id_here

# Network: mainnet, preprod, or preview (default: mainnet)
BLOCKFROST_NETWORK=mainnet
